    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsdown/css": "^0.22.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.1",
    "typescript": "~6.0.3",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.0.14",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vitepress": "^1.6.3",
